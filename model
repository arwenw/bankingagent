# 1. NEW LOGIC: Debt is now a "Dealbreaker"
# We generate 1000 customers this time (Law of Large Numbers)
X_new = torch.rand(1000, 3)

def calculate_strict_target(features):
    income, credit, debt = features
    # If debt is > 0.7, they are REJECTED (Target 0)
    if debt > 0.7:
        return 0.0
    # Otherwise, use a mix of income and credit
    score = (income * 0.5) + (credit * 0.5)
    return 1.0 if score > 0.5 else 0.0

y_new = torch.tensor([[calculate_strict_target(x)] for x in X_new])

# 2. RETRAIN (Using your 'Bigger' architecture)
model = nn.Sequential(
    nn.Linear(3, 128),
    nn.ReLU(),
    nn.Linear(128, 1),
    nn.Sigmoid()
)

optimizer = optim.Adam(model.parameters(), lr=0.01)
criterion = nn.BCELoss()

for epoch in range(300):
    optimizer.zero_grad()
    loss = criterion(model(X_new), y_new)
    loss.backward()
    optimizer.step()

# 3. TEST THE BAD CUSTOMER AGAIN
bad_customer = torch.tensor([[1.0, 1.0, 0.9]]) # High Income/Credit, but DEADLY DEBT
print(f"New Approval Probability for bad customer: {model(bad_customer).item():.4f}")

good_customer = torch.tensor([[1.0, 1.0, 0.1]]) # High Income/Credit, low DEBT
print(f"New Approval Probability for good customer: {model(good_customer).item():.4f}")




from sklearn.model_selection import train_test_split

# 1. Take our 1000 customers and split them
# X_train: Data to study | X_test: Data for the final exam
# y_train: Answers to study | y_test: Answers for the final exam
X_train, X_test, y_train, y_test = train_test_split(
    X_new, y_new, test_size=0.2, random_state=42
)

# 2. Train ONLY on the training set
for epoch in range(300):
    optimizer.zero_grad()
    # Notice we only use X_train here!
    train_preds = model(X_train)
    loss = criterion(train_preds, y_train)
    loss.backward()
    optimizer.step()

# 3. THE MOMENT OF TRUTH: Evaluate on the Test Set
model.eval() # Turn off 'learning mode'
with torch.no_grad(): # Don't calculate gradients (saves memory)
    test_preds = model(X_test)
    # Convert probabilities (> 0.5) to binary (0 or 1)
    predictions = (test_preds > 0.5).float()

    # Calculate Accuracy
    correct = (predictions == y_test).float().sum()
    accuracy = correct / y_test.shape[0]

print(f"Final Exam Accuracy: {accuracy.item() * 100:.2f}%")




