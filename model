import torch
import torch.nn as nn
import torch.optim as optim

# 1. GENERATE SYNTHETIC HISTORICAL DATA (100 Customers)
torch.manual_seed(42) # For reproducibility
X = torch.rand(100, 3) # 100 customers with 3 features [Income, Credit, Debt]

# Create "True" labels based on a logical rule:
# Target = (Income * 0.8) + (Credit * 1.2) - (Debt * 0.9)
# We add a little 'noise' because reality is messy
true_weights = torch.tensor([0.8, 1.2, -0.9])
y = torch.matmul(X, true_weights).unsqueeze(1) + torch.randn(100, 1) * 0.05

# 2. THE SCIENTIST'S UPGRADE: A Multi-Layer Model
model = nn.Sequential(
    nn.Linear(3, 5),   # Hidden Layer (Model 'thinks' about features)
    nn.ReLU(),         # Non-linearity (The 'Tipping Point' logic)
    nn.Linear(5, 1),   # Output Layer
    nn.Sigmoid()       # Squashes output between 0 and 1 (Probability of Approval)
)

# 3. TRAIN
optimizer = optim.Adam(model.parameters(), lr=0.05)
criterion = nn.BCELoss() # Binary Cross Entropy (better for 0 to 1 targets)

# We normalize y to be between 0 and 1 for the Sigmoid
y_norm = torch.sigmoid(y)

for epoch in range(500):
    preds = model(X)
    loss = criterion(preds, y_norm)
    optimizer.zero_grad(); loss.backward(); optimizer.step()
    if epoch % 100 == 0: print(f"Epoch {epoch}, Loss: {loss.item():.4f}")

# 4. TEST ON A "BAD" CUSTOMER
bad_customer = torch.tensor([[0.1, 0.2, 0.9]]) # Low income, low credit, high debt
print(f"\nProbability of Approval for Bad Customer: {model(bad_customer).item():.4f}")





# Save only the 'Learned Weights' (The State Dict)
torch.save(model.state_dict(), "banking_model.pth")

print("Model saved as banking_model.pth!")

