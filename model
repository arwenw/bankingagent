# FastAPI
from fastapi import FastAPI
from pydantic import BaseModel
import torch
import nest_asyncio
import uvicorn

# 1. Define what a "Valid Request" looks like (MLOps best practice)
class CustomerRequest(BaseModel):
    income: float
    credit_score: float
    debt: float

# 2. Initialize the App
app = FastAPI(title="Compliant Banking Agent API")

# 3. Load the "Saved Brain" (Assuming banking_model.pth exists)
# In production, we do this ONCE when the server starts
model = BankingBrain(3, 64)
model.load_state_dict(torch.load("banking_model.pth", map_location=torch.device('cpu')))
model.eval()

# 4. Create the "Prediction Endpoint" and add compliance rule
@app.post("/predict")
async def predict_loan(request: CustomerRequest):
    # 1. AI Logic
    data = torch.tensor([[request.income, request.credit_score, request.debt]])
    with torch.no_grad():
        probability = model(data).item()
    
    # 2. Compliance Rule Engine (Option A)
    compliance_failed = False
    failure_reason = ""
    
    # RULE 1: Maximum Debt Threshold (0.7)
    if request.debt > 0.7:
        compliance_failed = True
        failure_reason = "Debt-to-Income ratio exceeds regulatory safety limits."
    
    # RULE 2: Minimum Credit Score (Assumed 0.3 for scaled data)
    if request.credit_score < 0.2:
        compliance_failed = True
        failure_reason = "Credit score below minimum institutional requirements."

    # 3. Final Decision Logic
    if compliance_failed:
        final_decision = "Denied"
    else:
        final_decision = "Approved" if probability > 0.5 else "Denied"
    
    return {
        "ai_confidence": round(probability, 4),
        "compliance_status": "FAILED" if compliance_failed else "PASSED",
        "compliance_notes": failure_reason,
        "final_decision": final_decision
    }





# This allows FastAPI to run inside a Colab Notebook
import threading
def run():
    uvicorn.run(app, host="0.0.0.0", port=8000)

threading.Thread(target=run, daemon=True).start()

