import torch

# 1. Check for GPU (The 'Engine')
device = "cuda" if torch.cuda.is_available() else "cpu"
print(f"Using device: {device}")

# 2. Create a 2D Tensor (Like a mini-spreadsheet of 3 customers)
# Data: [Income, Credit Score, Debt Amount]
customer_data = torch.tensor([
    [50000, 720, 15000],
    [30000, 580, 45000],
    [120000, 810, 5000]
], dtype=torch.float32)

# 3. Move that data to the GPU!
customer_data = customer_data.to(device)

print(f"Customer Data Shape: {customer_data.shape}")
print(customer_data)

# 1. Our "Weights" (The bank's secret formula)
# Each number corresponds to: [Income, Score, Debt]
weights = torch.tensor([0.8, 1.2, -0.5], device=device)

# 2. Matrix Multiplication (The 'Dot Product')
# This multiplies each customer's data by the weights and sums them up
risk_scores = torch.matmul(customer_data, weights)

print("Calculated Risk Scores for 3 Customers:")
print(risk_scores)

