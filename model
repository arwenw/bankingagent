import torch
import torch.nn as nn
import torch.optim as optim
from sklearn.model_selection import train_test_split

# === STEP 1: OOP FOUNDATION (The Blueprint) ===
# We inherit from nn.Module so our model "remembers" its weights.
class BankingBrain(nn.Module):
    def __init__(self, input_size, hidden_size):
        super(BankingBrain, self).__init__()
        self.network = nn.Sequential(
            nn.Linear(input_size, hidden_size), # Layer 1
            nn.ReLU(),                          # The "Logic Switch"
            nn.Linear(hidden_size, 1),          # Output Layer
            nn.Sigmoid()                        # Probability (0 to 1)
        )

    def forward(self, x):
        return self.network(x)

# === STEP 2 & 5: TENSORS & DATA-CENTRIC AI (The History) ===
# We create 1000 customers. We use "Strict Logic" to label them.
X = torch.rand(1000, 3) # [Income, Credit, Debt]
# Policy: If debt (index 2) > 0.7, REJECT (Target 0).
y = torch.tensor([[0.0] if x[2] > 0.7 else [1.0] for x in X])

# === STEP 6: TRAIN-TEST SPLIT (The Final Exam) ===
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2)

# === STEP 3: LAYERS & ARCHITECTURE (The Setup) ===
device = "cuda" if torch.cuda.is_available() else "cpu"
model = BankingBrain(input_size=3, hidden_size=64).to(device)
criterion = nn.BCELoss() # The "Judge" for probabilities
optimizer = optim.Adam(model.parameters(), lr=0.01) # The "Teacher"

# === STEP 4: OPTIMIZATION (The Learning Loop) ===
for epoch in range(100):
    model.train()
    preds = model(X_train.to(device))
    loss = criterion(preds, y_train.to(device))

    optimizer.zero_grad()
    loss.backward() # Backpropagation
    optimizer.step() # Update Weights

# === FINAL EVALUATION ===
model.eval()
with torch.no_grad():
    test_results = model(X_test.to(device))
    accuracy = ((test_results > 0.5).float() == y_test.to(device)).float().mean()
    print(f"Workflow Complete. Model Accuracy: {accuracy.item()*100:.2f}%")


